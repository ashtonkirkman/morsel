# fastlane lanes for Morsel.
#
#   fastlane test    # unit tests on a simulator -- no Apple account needed
#   fastlane beta    # archive + upload to TestFlight -- Apple Developer Program + ASC API key
#
# Signing strategy (beta): fastlane `match` with git storage. A private repo holds the encrypted
# Apple Distribution certificate + App Store provisioning profile, so every CI run signs with the
# same identity and Apple's per-team certificate limits are never hit. Authentication to Apple is an
# App Store Connect API key (no Apple ID password, no 2FA prompts in CI).
#
# Environment (all provided by .github/workflows/testflight.yml from repository secrets):
#   APPLE_TEAM_ID                    10-char Team ID (developer.apple.com > Membership details)
#   ASC_KEY_ID / ASC_ISSUER_ID       App Store Connect > Users and Access > Integrations > Keys
#   ASC_KEY_CONTENT                  the .p8: raw PEM, PEM body only, or base64 of the file (all accepted)
#   MATCH_PASSWORD                   passphrase that encrypts the certificates repo
#   MATCH_GIT_URL                    https URL of the private certificates repo
#   MATCH_GIT_BASIC_AUTHORIZATION    base64("github-user:PAT") so CI can read/write that repo
#   BUILD_NUMBER                     optional; defaults to latest TestFlight build + 1
#   TESTFLIGHT_CHANGELOG             optional "what to test" text

default_platform(:ios)

PROJECT   = "Morsel.xcodeproj"
SCHEME    = "Morsel"
BUNDLE_ID = "com.ashtonkirkman.morsel"
APP_NAME  = "Morsel"

platform :ios do
  before_all do
    # Regenerate the project so lanes never depend on a stale checked-in .xcodeproj (there is none).
    sh("cd .. && xcodegen generate --spec project.yml")
  end

  desc "Run MorselTests on the newest iPhone simulator (no signing needed)"
  lane :test do
    udid = sh("cd .. && xcrun simctl list devices available -j | python3 scripts/pick_simulator.py").strip
    scan(
      project: PROJECT,
      scheme: SCHEME,
      destination: "platform=iOS Simulator,id=#{udid}",
      xcargs: "-skipPackagePluginValidation CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO",
      result_bundle: true,
      output_directory: "fastlane/test_output",
      code_coverage: true
    )
  end

  desc "Archive a Release build, sign with match, upload to TestFlight"
  lane :beta do
    %w[APPLE_TEAM_ID ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT MATCH_PASSWORD MATCH_GIT_URL].each do |k|
      UI.user_error!("#{k} is not set. See docs/INSTALL_ON_IPHONE.md (Route B).") if ENV[k].to_s.empty?
    end
    team_id = ENV["APPLE_TEAM_ID"]

    # On CI: create a throwaway keychain so match can import the signing identity.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: normalized_p8(ENV["ASC_KEY_CONTENT"]),
      is_key_content_base64: false,
      in_house: false
    )

    ensure_app_records_exist(api_key: api_key)

    # Fetch (or on the very first run, create) the distribution cert + App Store profile.
    match(
      type: "appstore",
      platform: "ios",
      app_identifier: BUNDLE_ID,
      team_id: team_id,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      git_branch: ENV.fetch("MATCH_GIT_BRANCH", "main"),
      readonly: ENV["MATCH_READONLY"] == "true",
      skip_docs: true
    )
    profile_name = ENV["sigh_#{BUNDLE_ID}_appstore_profile-name"]
    UI.user_error!("match did not export a profile name") if profile_name.to_s.empty?

    # Pin the app target to the match identity; everything else in the project stays untouched.
    update_code_signing_settings(
      path: PROJECT,
      targets: ["Morsel"],
      use_automatic_signing: false,
      team_id: team_id,
      bundle_identifier: BUNDLE_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_number = ENV["BUILD_NUMBER"].to_s
    if build_number.empty?
      latest = latest_testflight_build_number(api_key: api_key, app_identifier: BUNDLE_ID, initial_build_number: 0)
      build_number = (latest + 1).to_s
    end
    UI.message("Build number: #{build_number}")

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcodebuild_formatter: "xcpretty",
      xcargs: "-skipPackagePluginValidation CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { BUNDLE_ID => profile_name }
      },
      output_directory: "fastlane/build",
      output_name: "Morsel.ipa",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Internal build #{build_number}")
    )
    UI.success("Uploaded build #{build_number}. It appears in TestFlight after Apple processes it (5-30 min).")
  end

  # Accept the .p8 in any of the forms people paste into a GitHub secret:
  #   1. base64 of the whole file (starts with "LS0tLS1", which is "-----" encoded)
  #   2. the raw PEM including the BEGIN/END PRIVATE KEY lines
  #   3. just the body lines between BEGIN and END
  # and always hand fastlane a complete PEM.
  def normalized_p8(raw)
    require "base64"
    text = raw.to_s.strip
    UI.user_error!("ASC_KEY_CONTENT is empty") if text.empty?
    text = Base64.decode64(text).strip if text.start_with?("LS0tLS1")
    return text if text.include?("BEGIN PRIVATE KEY")
    body = text.gsub(/\s+/, "")
    UI.user_error!("ASC_KEY_CONTENT does not look like a .p8 key") unless body.match?(/\A[A-Za-z0-9+\/=]+\z/)
    "-----BEGIN PRIVATE KEY-----\n#{body.scan(/.{1,64}/).join("\n")}\n-----END PRIVATE KEY-----"
  end

  # Register the App ID in the Developer Portal through the API key (allowed), and check that the
  # App Store Connect app record exists. Apple's API does not allow creating app records
  # (`apps` only permits GET/UPDATE), so that one step stays manual and we stop early with
  # precise instructions instead of failing later inside the TestFlight upload.
  private_lane :ensure_app_records_exist do |options|
    require "spaceship"
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: options[:api_key])

    begin
      if Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
        UI.message("App ID #{BUNDLE_ID} already registered")
      else
        Spaceship::ConnectAPI::BundleId.create(name: APP_NAME, platform: Spaceship::ConnectAPI::BundleIdPlatform::IOS, identifier: BUNDLE_ID)
        UI.success("Registered App ID #{BUNDLE_ID}")
      end
    rescue StandardError => e
      UI.important("Could not register the App ID automatically: #{e.message}")
      UI.important("developer.apple.com > Certificates, Identifiers & Profiles > Identifiers > + > App IDs > App > Bundle ID (explicit) #{BUNDLE_ID}")
    end

    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    if app
      UI.message("App Store Connect record '#{app.name}' exists")
    else
      UI.user_error!(<<~MSG)
        No App Store Connect app record exists for #{BUNDLE_ID} yet, and Apple's API does not allow creating one.
        One-time manual step: appstoreconnect.apple.com > My Apps > + > New App
          Platform: iOS   Name: any unique name (shown on TestFlight; changeable later)
          Primary language: English (U.S.)   Bundle ID: pick "#{BUNDLE_ID}" from the list
          SKU: morsel-ios   User Access: Full Access
        Then re-run this workflow.
      MSG
    end
  end
end
