# fastlane lanes for Morsel.
#
#   bundle exec fastlane test    # unit tests on a simulator -- works with a free Apple ID / no account
#   bundle exec fastlane beta    # archive + upload to TestFlight -- REQUIRES the $99 Apple Developer Program
#
# Signing strategy: no `match`, no manually managed certificates. We rely on Xcode automatic signing
# (`-allowProvisioningUpdates`) authenticated with an App Store Connect API key supplied via env:
#   ASC_KEY_ID        App Store Connect > Users and Access > Integrations > Keys (Key ID)
#   ASC_ISSUER_ID     Issuer ID from the same page
#   ASC_KEY_CONTENT   The .p8 file contents (base64 or raw PEM); never commit this
# plus DEVELOPMENT_TEAM set in project.yml (or FASTLANE_TEAM_ID).
#
# Nothing in this file can run in the current environment (Windows/WSL, no Mac). It is prepared so the
# first day with a Mac + account is `xcodegen generate && bundle exec fastlane beta`.

default_platform(:ios)

PROJECT = "Morsel.xcodeproj"
SCHEME  = "Morsel"

platform :ios do
  before_all do
    # Regenerate the project so lanes never depend on a stale checked-in .xcodeproj (there is none).
    sh("cd .. && xcodegen generate --spec project.yml")
  end

  desc "Run MorselTests on the newest iPhone simulator (no signing needed)"
  lane :test do
    udid = sh("cd .. && xcrun simctl list devices available -j | python3 scripts/pick_simulator.py").strip
    scan(
      project: PROJECT,
      scheme: SCHEME,
      destination: "platform=iOS Simulator,id=#{udid}",
      xcargs: "-skipPackagePluginValidation CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO",
      result_bundle: true,
      output_directory: "fastlane/test_output",
      code_coverage: true
    )
  end

  desc "Archive a Release build and upload it to TestFlight (needs the Apple Developer Program)"
  lane :beta do
    %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_CONTENT].each do |k|
      UI.user_error!("#{k} is not set. See fastlane/README.md.") if ENV[k].to_s.empty?
    end

    # The API key authenticates both automatic provisioning (xcodebuild -allowProvisioningUpdates)
    # and the TestFlight upload. Not stored on disk beyond this process.
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: ENV.fetch("ASC_KEY_CONTENT_BASE64", "false") == "true",
      in_house: false
    )

    # Bump the build number from TestFlight so uploads never collide.
    latest = latest_testflight_build_number(api_key: api_key, initial_build_number: 0)
    increment_build_number(build_number: latest + 1, xcodeproj: PROJECT)

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcodebuild_formatter: "xcpretty",
      xcargs: "-allowProvisioningUpdates -skipPackagePluginValidation",
      output_directory: "fastlane/build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      changelog: ENV.fetch("TESTFLIGHT_CHANGELOG", "Internal build")
    )
  end
end
