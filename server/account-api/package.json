{
  "name": "freetrack-account-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker + D1 that gives Free Track user accounts (Apple / Google / Facebook sign-in) and a per-user document sync store.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "wrangler d1 migrations apply freetrack --remote",
    "migrate:local": "wrangler d1 migrations apply freetrack --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
